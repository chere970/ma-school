// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  firstName String
  lastName  String

  email            String
  passwordHash     String
  refreshTokenHash String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, email])
}

model Role {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  description String?

  users User[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
}

model Tenant {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  domain String? @unique

  email String? @unique
  phone String? @unique

  roles Role[]

  logo String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  campuses            Campus[]
  departments         Department[]
  programs            Program[]
  courses             Course[]
  students            Student[]
  teachers            Teacher[]
  enorllments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  rooms               Room[]
  timetables          Timetable[]
  attendance          Attendance[]
  assessments         Assessment[]
  grades              Grade[]
}

model Permission {
  id String @id @default(cuid())

  name String @unique

  description String?
}

model Campus {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name    String
  code    String
  address String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  rooms       Room[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model Department {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  name        String
  code        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs Program[]
  courses  Course[]
  teachers Teacher[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model Program {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  name          String
  code          String
  degree        String?
  durationYears Int?
  description   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses  Course[]
  students Student[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model Course {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  code        String
  name        String
  description String?

  creditHours Int
  semester    Int?
  yearLevel   Int?

  isActive Boolean @default(true)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model Student {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentNumber String

  firstName  String
  middleName String?
  lastName   String

  email String?
  phone String?

  dateOfBirth DateTime?

  gender String?

  admissionYear Int
  yearLevel     Int

  programId String
  program   Program @relation(fields: [programId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentEnrollments Enrollment[]
  attendances        Attendance[]

  @@unique([tenantId, studentNumber])
  @@unique([tenantId, email])
}

model Teacher {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  employeeNumber String

  firstName  String
  middleName String?
  lastName   String

  email String?
  phone String?

  specialization String?
  hireDate       DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  isActive Boolean @default(true)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  teachingAssignments TeachingAssignment[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
}

model Enrollment {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  enrollmentDate DateTime @default(now())

  status EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]

  @@unique([tenantId, studentId, courseId])
  @@index([tenantId])
  @@index([studentId])
  @@index([courseId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  WITHDRAWN
}

model TeachingAssignment {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  assignedAt DateTime @default(now())

  isActive Boolean @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  timetables  Timetable[]
  attendances Attendance[]
  assessments Assessment[]

  @@unique([tenantId, teacherId, courseId])
  @@index([tenantId])
  @@index([teacherId])
  @@index([courseId])
}

model Room {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  campusId String
  campus   Campus @relation(fields: [campusId], references: [id])

  name String
  code String

  capacity Int

  type String?

  isActive Boolean @default(true)

  timetables Timetable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
}

model Timetable {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teachingAssignmentId String
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  dayOfWeek Int

  startTime String
  endTime   String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([teachingAssignmentId])
  @@index([roomId])
  @@index([tenantId, dayOfWeek])
}
model Attendance {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  teachingAssignmentId String
  teachingAssignment   TeachingAssignment @relation( fields: [teachingAssignmentId],references: [id])

  date DateTime

  status AttendanceStatus @default(PRESENT)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId,studentId,teachingAssignmentId,date])

  @@index([tenantId])
  @@index([studentId])
  @@index([teachingAssignmentId])
  @@index([tenantId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  QUIZ
  ASSIGNMENT
  MIDTERM
  FINAL
  PROJECT
  PRACTICAL
  CONTINUOUS_ASSESSMENT
}

enum GradeStatus {
  DRAFT
  PUBLISHED
  FINALIZED
}

model Assessment {
  id       String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  teachingAssignmentId String
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id])

  title          String
  description    String?
  type           AssessmentType
  maxScore       Float
  weight         Float
  assessmentDate DateTime?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades Grade[]

  @@unique([tenantId, teachingAssignmentId, title])
  @@index([tenantId])
  @@index([teachingAssignmentId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
}

model Grade {
  id       String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  score   Float
  remarks String?
  status  GradeStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, assessmentId, enrollmentId])
  @@index([tenantId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([tenantId, status])
}